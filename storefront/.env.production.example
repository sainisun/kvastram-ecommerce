# ============================================================
# Storefront - Production Environment Variables
# ============================================================
# Copy to storefront/.env.production on the VPS and fill values.
# DO NOT commit this file with real secrets.
# ============================================================

# Public API URL — browser-accessible backend endpoint.
# Used as a build-time arg in Docker (NEXT_PUBLIC_API_URL).
# Set in deploy/hostinger/.env instead (docker-compose reads it as build arg).
# NEXT_PUBLIC_API_URL=https://api.kvastram.com

# Internal API URL — server-to-server inside Docker network.
# Set automatically by docker-compose; no need to set here.
# INTERNAL_API_URL=http://backend:4000

# Sentry (optional — remove if not using Sentry)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Node environment (set automatically by docker-compose)
NODE_ENV=production
