{
  "name": "kvastram-backend",
  "version": "1.0.0",
  "scripts": {
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.lint.core.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "check:all": "concurrently -k -s first \"npm run dev\" \"wait-on tcp:4000 && npx tsx scripts/debug/test-core-flows.ts && echo '✅ ALL CHECKS PASSED!'\"",
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:pg --external:postgres --external:bcryptjs --external:jsonwebtoken --external:speakeasy --external:socket.io && esbuild src/db/migrate.ts --bundle --platform=node --outfile=dist/migrate.js --external:pg --external:postgres && esbuild src/db/run-manual-migrations.ts --bundle --platform=node --outfile=dist/run-manual-migrations.js --external:pg --external:postgres",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "generate": "drizzle-kit generate:pg",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "unlock-admin": "NODE_ENV=production tsx src/db/unlock-admin.ts",
    "seed:tags": "tsx scripts/seed-default-tags.ts",
    "migrate:manual": "NODE_ENV=production tsx src/db/run-manual-migrations.ts",
    "migrate:manual:prod": "node dist/run-manual-migrations.js",
    "seed:admin": "NODE_ENV=production tsx src/db/seed.ts",
    "seed:regions": "tsx src/db/seed-global-regions.ts",
    "seed:pages": "tsx scripts/seed-pages.ts",
    "seed:legal-pages": "tsx scripts/seed-legal-pages.ts",
    "seed:settings": "tsx scripts/seed-settings.ts",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "seed:wholesale-tiers": "tsx scripts/seed-wholesale-tiers.ts",
    "seed:all": "npm run seed:regions && npm run seed:settings && npm run seed:tags && npm run seed:pages && npm run seed:legal-pages && npm run seed:categories && npm run seed:wholesale-tiers"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.2.1",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.9.40",
    "@types/nodemailer": "^7.0.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.11.7",
    "hono-rate-limiter": "^0.5.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "speakeasy": "^2.0.0",
    "string-replace-async": "^3.0.2",
    "socket.io": "^4.8.1",
    "stripe": "^17.7.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.9",
    "chalk": "^4.1.2",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.20.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.3"
  }
}
